# "A project ends. A product continues" — quoted directly from the post. A bounded line
# against an open one, rather than another pair of feedback loops.
direction: down

consulting: Consulting {
  direction: right
  start1: ""  { shape: circle; width: 24 }
  mid1: "agreed scope,\nagreed date"
  end1: "a project ends" { shape: rectangle; style.fill: "#171717"; style.font-color: "#ffffff" }
  start1 -> mid1 -> end1
}

product: Product {
  direction: right
  start2: "" { shape: circle; width: 24 }
  mid2: "refactoring,\ndebt, migrations"
  cont: "a product continues …" { shape: rectangle; style.stroke-dash: 4 }
  start2 -> mid2 -> cont
}
