---
import { TAGS, type TagName } from '../consts';

interface Props {
	tags: readonly TagName[];
	/** Rendered smaller inside the post list, larger under a post title. */
	size?: 'sm' | 'md';
}

const { tags, size = 'md' } = Astro.props;
const text = size === 'sm' ? 'text-sm' : 'text-base';
---

<ul class:list={['m-0 flex list-none flex-wrap gap-2 p-0', text]}>
	{
		tags.map((tag) => (
			<li class="m-0 p-0">
				<a
					href={`/tags/${tag}/`}
					class="inline-block rounded-sm border border-border px-2 py-0.5 text-muted no-underline transition-colors hover:border-accent hover:text-accent"
					rel="tag"
				>
					{TAGS[tag].label}
				</a>
			</li>
		))
	}
</ul>
