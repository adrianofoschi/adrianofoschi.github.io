---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { Font } from 'astro:assets';
import { AUTHOR, AUTHOR_PROFILES, OG_IMAGE, SITE_TITLE, TAGS, type TagName } from '../consts';
import { isoDate } from '../utils/date';

interface Props {
	title: string;
	description: string;
	/** `article` on blog posts, `profile` on the about page, `website` everywhere else. */
	type?: 'website' | 'article' | 'profile';
	/** Extra schema.org nodes to publish alongside the page's own entity. */
	schemaExtras?: object[];
	pubDate?: Date;
	updatedDate?: Date;
	tags?: readonly TagName[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(OG_IMAGE, Astro.site);

const {
	title,
	description,
	type = 'website',
	pubDate,
	updatedDate,
	tags = [],
	schemaExtras = [],
} = Astro.props;

// Structured data: a BlogPosting on articles, the site itself elsewhere. Both carry the author
// as a Person, so every page is attributable — which is what crawlers and AI search look for,
// and which this site otherwise states only in prose.
const author = {
	'@type': 'Person',
	name: AUTHOR.name,
	url: AUTHOR.url,
	sameAs: [...AUTHOR_PROFILES],
};

const person = {
	...author,
	'@id': `${new URL('/about', Astro.site).href}#person`,
	jobTitle: 'Chief Technology Officer',
	description:
		'Full-stack engineer with 20+ years of experience, from self-taught teenage projects to leading software architecture as a CTO.',
	knowsAbout: [
		'software architecture',
		'AI-assisted software development',
		'blockchain',
		'wallets',
		'authentication',
		'TypeScript',
		'NestJS',
	],
};

const mainEntity =
	type === 'article'
		? {
				'@type': 'BlogPosting',
				headline: title,
				description,
				url: canonicalURL.href,
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
				datePublished: pubDate && isoDate(pubDate),
				dateModified: (updatedDate ?? pubDate) && isoDate(updatedDate ?? pubDate!),
				keywords: tags.map((tag) => TAGS[tag].label).join(', '),
				articleSection: tags.map((tag) => TAGS[tag].label),
				inLanguage: 'en',
				image: ogImageURL.href,
				author: { '@id': person['@id'] },
				publisher: { '@id': person['@id'] },
				isPartOf: { '@type': 'Blog', '@id': `${new URL('/', Astro.site).href}#blog` },
			}
		: type === 'profile'
			? {
					'@type': 'ProfilePage',
					url: canonicalURL.href,
					name: title,
					description,
					inLanguage: 'en',
					mainEntity: { '@id': person['@id'] },
				}
			: {
					'@type': 'WebSite',
					name: SITE_TITLE,
					description,
					url: new URL('/', Astro.site).href,
					inLanguage: 'en',
					author: { '@id': person['@id'] },
				};

// One @graph per page: the page's own entity, the author as a stable @id every page points
// at, and whatever the page adds (the home page publishes its post list this way).
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [mainEntity, person, ...schemaExtras],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!--
	Only the sans is preloaded. `preload` emits a link per emitted face, so preloading
	both families put sixteen font requests on the critical path — for the mono, which
	only dresses the nav, the dateline and the tags, a brief swap costs less than that.
-->
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<!-- Open Graph wants language_TERRITORY here, not a bare language code. -->
<meta property="og:locale" content="en_US" />
{
	type === 'article' && (
		<Fragment>
			<meta property="article:author" content={AUTHOR.name} />
			{pubDate && <meta property="article:published_time" content={isoDate(pubDate)} />}
			{
				/* Falls back to the publication date, matching `dateModified` in the JSON-LD:
				   a post with no later edit was last modified when it was published. */
				(updatedDate ?? pubDate) && (
					<meta property="article:modified_time" content={isoDate(updatedDate ?? pubDate!)} />
				)
			}
			{tags.map((tag) => (
				<meta property="article:tag" content={TAGS[tag].label} />
			))}
		</Fragment>
	)
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
