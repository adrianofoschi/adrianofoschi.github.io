---
import { AUTHOR, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<header class="border-b border-border bg-bg px-4">
	<nav class="mx-auto flex max-w-[720px] items-center justify-between">
		{/*
		 * Not a heading: the brand is navigation, and wrapping it in one put an
		 * out-of-order <h2> ahead of the <h1> on every post in the site.
		 */}
		<span class="text-base font-bold">
			<a href="/" class="text-fg no-underline">{SITE_TITLE}</a>
		</span>
		<div class="flex items-center">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/tags">topics</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
			<HeaderLink href={AUTHOR.cv} target="_blank" rel="me noopener">
				cv
			</HeaderLink>
		</div>
		<div class="hidden items-center gap-3 sm:flex">
			<SocialLinks />
		</div>
	</nav>
</header>
