---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TagList from '../components/TagList.astro';
import type { TagName } from '../consts';
import { heroPosterURL } from '../utils/hero';

// Used by blog posts and by the standalone About page, which passes no tags — hence the
// optional `tags`, and hence a page without them being a `website` rather than an `article`.
interface Props {
	title: string;
	description: string;
	/** Every post has one; the About page is a profile, and a date on it would only claim
	 * that the page was written that day. */
	pubDate?: Date;
	updatedDate?: Date;
	tags?: readonly TagName[];
	/** The About page is a profile, not an article. */
	type?: 'website' | 'article' | 'profile';
	/** Slug of the post, used to pick related reading. Absent on the About page. */
	id?: string;
	/** Every post has one of these two; the About page has neither. */
	heroImage?: ImageMetadata;
	heroVideo?: string;
	heroPoster?: ImageMetadata;
	heroAlt?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	type,
	id,
	heroImage,
	heroVideo,
	heroPoster,
	heroAlt,
} = Astro.props;

// The video itself plays only on the post page. Everywhere else that needs one flat image —
// the social card here, and the listings — gets the poster.
const posterURL = heroVideo && heroPoster ? await heroPosterURL(heroPoster) : undefined;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			type={type ?? (tags.length ? 'article' : 'website')}
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
			image={heroImage ?? heroPoster}
		/>
	</head>

	<body>
		<Header />
		<main class="w-full">
			<article>
				{
					/*
					 * The hero is fixed at 2:1 and filled, so every post opens on the same shape.
					 * It is content, not decoration — a recovered artefact, a diagram of something
					 * the post describes, or a video of the thing itself — which is why its alt
					 * text is required by the schema rather than left empty. A video hero doesn't
					 * autoplay: like the YouTube embeds already used inline elsewhere, it plays on
					 * request rather than costing bandwidth to everyone who opens the post.
					 */
					heroVideo ? (
						<div class="mx-auto w-full max-w-[760px] px-4 pt-8">
							<video
								src={heroVideo}
								poster={posterURL}
								controls
								preload="metadata"
								aria-label={heroAlt}
								class="aspect-[2/1] w-full rounded-md border border-border bg-bg object-cover"
							/>
						</div>
					) : (
						heroImage && (
							<div class="mx-auto w-full max-w-[760px] px-4 pt-8">
								<Image
									src={heroImage}
									alt={heroAlt ?? ''}
									widths={[760, 1520]}
									sizes="(min-width: 800px) 760px, 100vw"
									class="aspect-[2/1] w-full rounded-md border border-border bg-bg object-cover"
								/>
							</div>
						)
					)
				}
				<div class="mx-auto w-full max-w-[760px] px-4 py-8">
					<div class="mb-8 text-center">
						{
							pubDate && (
								<p class="mb-2 text-muted">
									<FormattedDate date={pubDate} />
									{updatedDate && (
										<span class="block italic">
											Last updated on <FormattedDate date={updatedDate} />
										</span>
									)}
								</p>
							)
						}
						<h1 class="mb-4 text-4xl font-bold leading-tight text-fg">{title}</h1>
						{
							tags.length > 0 && (
								<div class="mb-4 flex justify-center">
									<TagList tags={tags} size="sm" />
								</div>
							)
						}
						<hr class="border-border" />
					</div>
					{/*
					 * The measure is capped in `ch` rather than left to fill the column:
					 * the sans fits far more characters per line than the monospace it
					 * replaced, and the full 760px ran to nearly 90 characters a line.
					 */}
					<div
						class="prose prose-lg mx-auto max-w-[68ch] prose-p:text-fg prose-headings:text-fg prose-strong:text-fg prose-a:text-accent prose-blockquote:border-accent prose-blockquote:text-muted prose-code:text-accent prose-hr:border-border prose-img:rounded-md prose-img:border prose-img:border-border prose-figcaption:text-muted"
					>
						<slot />
					</div>
					{id && tags.length > 0 && <RelatedPosts currentId={id} tags={tags} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
