---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import TagList from '../components/TagList.astro';
import type { TagName } from '../consts';

// Used by blog posts and by the standalone About page, which passes no tags — hence the
// optional `tags`, and hence a page without them being a `website` rather than an `article`.
interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: readonly TagName[];
	/** The About page is a profile, not an article. */
	type?: 'website' | 'article' | 'profile';
	/** Slug of the post, used to pick related reading. Absent on the About page. */
	id?: string;
}

const { title, description, pubDate, updatedDate, tags = [], type, id } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			type={type ?? (tags.length ? 'article' : 'website')}
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
		/>
	</head>

	<body>
		<Header />
		<main class="w-full">
			<article>
				<div class="mx-auto w-full max-w-[760px] px-4 py-8">
					<div class="mb-8 text-center">
						<p class="mb-2 text-muted">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="block italic">
										Last updated on <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</p>
						<h1 class="mb-4 text-4xl font-bold leading-tight text-fg">{title}</h1>
						{
							tags.length > 0 && (
								<div class="mb-4 flex justify-center">
									<TagList tags={tags} size="sm" />
								</div>
							)
						}
						<hr class="border-border" />
					</div>
					<div
						class="prose prose-lg max-w-none prose-p:text-fg prose-headings:text-fg prose-strong:text-fg prose-a:text-accent prose-blockquote:border-accent prose-blockquote:text-muted prose-code:text-accent prose-hr:border-border prose-img:rounded-md prose-img:border prose-img:border-border prose-figcaption:text-muted"
					>
						<slot />
					</div>
					{id && tags.length > 0 && <RelatedPosts currentId={id} tags={tags} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
