---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { isoDate } from '../utils/date';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

const siteURL = new URL('/', Astro.site).href;
const postURL = (id: string) => new URL(`/blog/${id}/`, Astro.site).href;

const blogSchema = {
	'@type': 'Blog',
	'@id': `${siteURL}#blog`,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: siteURL,
	inLanguage: 'en',
	blogPost: page.data.map((post) => ({
		'@type': 'BlogPosting',
		headline: post.data.title,
		description: post.data.description,
		url: postURL(post.id),
		datePublished: isoDate(post.data.pubDate),
	})),
};

const itemListSchema = {
	'@type': 'ItemList',
	name: `Posts on ${SITE_TITLE}`,
	itemListOrder: 'https://schema.org/ItemListOrderDescending',
	numberOfItems: page.data.length,
	itemListElement: page.data.map((post, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: postURL(post.id),
		name: post.data.title,
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			schemaExtras={[blogSchema, itemListSchema]}
		/>
	</head>
	<body>
		<Header />
		<main class="mx-auto w-full max-w-[720px] px-4 py-12">
			<section>
				<ul class="flex flex-col gap-10">
					{
						page.data.map((post) => (
							<li class="border-b border-border pb-10 last:border-0 last:pb-0">
								<a href={`/blog/${post.id}/`} class="group block no-underline">
									<p class="mb-1 text-muted">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h4 class="text-xl font-bold leading-tight text-fg transition-colors group-hover:text-accent">
										{post.data.title}
									</h4>
									<p class="mt-2 text-muted">{post.data.description}</p>
								</a>
								<div class="mt-3">
									<TagList tags={post.data.tags} size="sm" />
								</div>
							</li>
						))
					}
				</ul>
				{
					(page.url.prev || page.url.next) && (
						<nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
							{page.url.prev ? (
								<a href={page.url.prev} class="text-accent hover:underline">
									&larr; newer posts
								</a>
							) : (
								<span />
							)}
							<span class="text-muted">
								page {page.currentPage} of {page.lastPage}
							</span>
							{page.url.next ? (
								<a href={page.url.next} class="text-accent hover:underline">
									older posts &rarr;
								</a>
							) : (
								<span />
							)}
						</nav>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
