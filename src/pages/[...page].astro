---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import portrait from '../assets/blog/about-me/portrait.png';
import PostList from '../components/PostList.astro';
import Listing from '../layouts/Listing.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { isoDate } from '../utils/date';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

const siteURL = new URL('/', Astro.site).href;
const postURL = (id: string) => new URL(`/blog/${id}/`, Astro.site).href;

const blogSchema = {
	'@type': 'Blog',
	'@id': `${siteURL}#blog`,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: siteURL,
	inLanguage: 'en',
	blogPost: page.data.map((post) => ({
		'@type': 'BlogPosting',
		headline: post.data.title,
		description: post.data.description,
		url: postURL(post.id),
		datePublished: isoDate(post.data.pubDate),
	})),
};

const itemListSchema = {
	'@type': 'ItemList',
	name: `Posts on ${SITE_TITLE}`,
	itemListOrder: 'https://schema.org/ItemListOrderDescending',
	numberOfItems: page.data.length,
	itemListElement: page.data.map((post, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: postURL(post.id),
		name: post.data.title,
	})),
};
---

<Listing
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	active="all"
	schemaExtras={[blogSchema, itemListSchema]}
	image={portrait}
>
	{/*
	 * The home page is a list by design, so its <h1> is there for machines and screen
	 * readers rather than for the layout. It says what the page is — no keywords it does
	 * not otherwise earn.
	 */}
	<h1 class="sr-only">
		{SITE_TITLE} — {SITE_DESCRIPTION}
		{page.currentPage > 1 && ` (page ${page.currentPage})`}
	</h1>
	<PostList posts={page.data} />
	{
		(page.url.prev || page.url.next) && (
			<nav class="mt-10 flex items-center justify-between" aria-label="Pagination">
				{page.url.prev ? (
					<a href={page.url.prev} class="text-accent hover:underline">
						&larr; newer posts
					</a>
				) : (
					<span />
				)}
				<span class="text-muted">
					page {page.currentPage} of {page.lastPage}
				</span>
				{page.url.next ? (
					<a href={page.url.next} class="text-accent hover:underline">
						older posts &rarr;
					</a>
				) : (
					<span />
				)}
			</nav>
		)
	}
</Listing>
