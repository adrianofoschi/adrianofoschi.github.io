---
import type { GetStaticPaths, Page } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { isoDate } from '../utils/date';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

const siteURL = new URL('/', Astro.site).href;
const postURL = (id: string) => new URL(`/blog/${id}/`, Astro.site).href;

const blogSchema = {
	'@type': 'Blog',
	'@id': `${siteURL}#blog`,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: siteURL,
	inLanguage: 'en',
	blogPost: page.data.map((post) => ({
		'@type': 'BlogPosting',
		headline: post.data.title,
		description: post.data.description,
		url: postURL(post.id),
		datePublished: isoDate(post.data.pubDate),
	})),
};

const itemListSchema = {
	'@type': 'ItemList',
	name: `Posts on ${SITE_TITLE}`,
	itemListOrder: 'https://schema.org/ItemListOrderDescending',
	numberOfItems: page.data.length,
	itemListElement: page.data.map((post, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: postURL(post.id),
		name: post.data.title,
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			schemaExtras={[blogSchema, itemListSchema]}
		/>
	</head>
	<body>
		<Header />
		<main class="mx-auto w-full max-w-[720px] px-4 py-12">
			<section>
				{/*
				 * The home page is a bare list by design, so its <h1> is there for machines
				 * and screen readers rather than for the layout. It says what the page is —
				 * no keywords it does not otherwise earn.
				 */}
				<h1 class="sr-only">
					{SITE_TITLE} — {SITE_DESCRIPTION}
					{page.currentPage > 1 && ` (page ${page.currentPage})`}
				</h1>
				{/* No rules between entries — the gap alone separates them, so it has
				    to be wider than it was when a border was doing half the work. */}
				<ul class="flex flex-col gap-14">
					{
						page.data.map((post) => (
<li>
								{/*
								 * The hero sits above the title, at the full width of the column, the
								 * same way it opens the post itself. At the 260px it had beside the
								 * text, a diagram was an illegible smudge.
								 */}
								<a href={`/blog/${post.id}/`} class="group block no-underline">
									<Image
										src={post.data.heroImage}
										alt=""
										widths={[720, 1440]}
										sizes="(min-width: 760px) 720px, 100vw"
										class="mb-4 aspect-[2/1] w-full rounded-md border border-border object-cover transition-colors group-hover:border-accent"
									/>
									<p class="mb-1 text-muted">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h2 class="text-xl font-bold leading-tight text-fg transition-colors group-hover:text-accent">
										{post.data.title}
									</h2>
									<p class="mt-2 text-muted">{post.data.description}</p>
								</a>
								<div class="mt-3">
									<TagList tags={post.data.tags} size="sm" />
								</div>
							</li>
						))
					}
				</ul>
				{
					(page.url.prev || page.url.next) && (
						<nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
							{page.url.prev ? (
								<a href={page.url.prev} class="text-accent hover:underline">
									&larr; newer posts
								</a>
							) : (
								<span />
							)}
							<span class="text-muted">
								page {page.currentPage} of {page.lastPage}
							</span>
							{page.url.next ? (
								<a href={page.url.next} class="text-accent hover:underline">
									older posts &rarr;
								</a>
							) : (
								<span />
							)}
						</nav>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
