---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import PostList from '../../components/PostList.astro';
import Listing from '../../layouts/Listing.astro';
import { SITE_TITLE, TAGS, TAG_NAMES, type TagName } from '../../consts';

export const getStaticPaths = (async () => {
	const posts = await getCollection('blog');
	return TAG_NAMES.map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((post) => post.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}) satisfies GetStaticPaths;

type Props = { tag: TagName; posts: CollectionEntry<'blog'>[] };

const { tag, posts } = Astro.props;
const { label, description } = TAGS[tag];
const title = `${label} — ${SITE_TITLE}`;
---

{/* Same shell as the home page, with this topic's tab current — that is what makes the
    tabs read as tabs rather than as a row of links. */}
<Listing title={title} description={description} active={tag}>
	<h1 class="mb-2 text-2xl font-bold leading-tight text-fg">{label}</h1>
	<p class="mb-2 text-muted">{description}</p>
	{/* No "all topics" link any more: the tabs above are the list of topics. */}
	<p class="mb-8 text-sm text-muted">
		{`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`}
	</p>
	<PostList posts={posts} />
</Listing>
