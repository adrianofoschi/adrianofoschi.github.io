---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import TagList from '../../components/TagList.astro';
import { SITE_TITLE, TAGS, TAG_NAMES, type TagName } from '../../consts';

export const getStaticPaths = (async () => {
	const posts = await getCollection('blog');
	return TAG_NAMES.map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((post) => post.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}) satisfies GetStaticPaths;

type Props = { tag: TagName; posts: CollectionEntry<'blog'>[] };

const { tag, posts } = Astro.props;
const { label, description } = TAGS[tag];
const title = `${label} — ${SITE_TITLE}`;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="mx-auto w-full max-w-[720px] px-4 py-12">
			<h1 class="mb-2 text-3xl font-bold leading-tight text-fg">{label}</h1>
			<p class="mb-2 text-muted">{description}</p>
			<p class="mb-10 text-sm text-muted">
				{`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`} · <a
					href="/tags/"
					class="text-accent">all topics</a
				>
			</p>
			<ul class="flex flex-col gap-14">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="group block no-underline">
								<p class="mb-1 text-muted">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h2 class="text-xl font-bold leading-tight text-fg transition-colors group-hover:text-accent">
									{post.data.title}
								</h2>
								<p class="mt-2 text-muted">{post.data.description}</p>
							</a>
							<div class="mt-3">
								<TagList tags={post.data.tags} size="sm" />
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
