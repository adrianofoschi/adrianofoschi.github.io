---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, TAGS, TAG_NAMES } from '../../consts';

const posts = await getCollection('blog');
const topics = TAG_NAMES.map((tag) => ({
	tag,
	...TAGS[tag],
	count: posts.filter((post) => post.data.tags.includes(tag)).length,
})).sort((a, b) => b.count - a.count);

const title = `Topics — ${SITE_TITLE}`;
const description =
	'Every topic covered here, from blockchain and wallets to architecture, AI-assisted development and the early projects.';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="mx-auto w-full max-w-[720px] px-4 py-12">
			<h1 class="mb-2 text-3xl font-bold leading-tight text-fg">Topics</h1>
			<p class="mb-10 text-muted">{description}</p>
			<ul class="flex flex-col gap-10">
				{
					topics.map(({ tag, label, description, count }) => (
						<li>
							<a href={`/tags/${tag}/`} class="group block no-underline">
								<h2 class="text-xl font-bold leading-tight text-fg transition-colors group-hover:text-accent">
									{label}
									<span class="ml-2 text-sm font-normal text-muted">
										{count} {count === 1 ? 'post' : 'posts'}
									</span>
								</h2>
								<p class="mt-2 text-muted">{description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
